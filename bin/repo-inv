#!/usr/bin/env node

const { Command } = require('commander');
const chalk = require('chalk');
const fs = require('fs');
const os = require('os');
const path = require('path');
const { listTools, getTool, checkTool } = require('../lib/tools');
const { runAnatomy, runArchitecture, runLogic, runEfficiency, generateSummary } = require('../lib/runner');
const db = require('../lib/db');
const { buildStandardGuide, buildBorrowGuide, buildProjectReview } = require('../lib/insights');

const program = new Command();

// Default output root lives outside any target repo so analyses don't pollute
// the inspected repo's working tree. Each run gets its own timestamped folder.
const DEFAULT_OUT_ROOT = path.join(os.homedir(), '.cache', 'repo-inv');
function defaultOutputFor(repoPath) {
  const stamp = new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19);
  return path.join(DEFAULT_OUT_ROOT, `${path.basename(repoPath)}-${stamp}`);
}

program
  .name('repo-inv')
  .description('Three-layer code repository investigation toolkit')
  .version('1.0.0');

program
  .command('analyze <repo>')
  .description('Run investigation on a repository')
  .option('-l, --layer <layers>', 'Layers to run: anatomy,arch,logic,efficiency (default: all)', 'all')
  .option('-o, --output <dir>', 'Output directory (default: ~/.cache/repo-inv/<repo>-<ts>)')
  .option('-p, --parallel', 'Run the three layers concurrently (~3x faster, interleaved logs)')
  .option('--profile <name>', 'Architecture standard profile: generic,pure_agent,rag_agent,crm_agent', 'generic')
  .action(async (repo, options) => {
    const absRepo = path.resolve(repo);
    if (!fs.existsSync(absRepo)) {
      console.error(chalk.red(`Error: ${absRepo} does not exist`));
      process.exit(1);
    }
    if (!fs.statSync(absRepo).isDirectory()) {
      console.error(chalk.red(`Error: ${absRepo} is not a directory`));
      process.exit(1);
    }

    const absOut = path.resolve(options.output || defaultOutputFor(absRepo));
    fs.mkdirSync(absOut, { recursive: true });

    console.log(chalk.bold('🔍 Repo Investigator v1.0.0'));
    console.log(`   Target: ${chalk.cyan(absRepo)}`);
    console.log(`   Output: ${chalk.cyan(absOut)}`);
    console.log(`   Layers: ${chalk.yellow(options.layer)}${options.parallel ? chalk.magenta(' [parallel]') : ''}`);

    const layers = options.layer === 'all' ? ['anatomy', 'arch', 'logic', 'efficiency'] : options.layer.split(',');
    const runners = {
      anatomy: () => runAnatomy(absRepo, absOut, { profile: options.profile }),
      arch: () => runArchitecture(absRepo, absOut),
      logic: () => runLogic(absRepo, absOut),
      efficiency: () => runEfficiency(absRepo, absOut),
    };

    if (options.parallel) {
      // Layers write to disjoint output subdirs, so they're safe to run concurrently.
      // Logs interleave; trade-off accepted for ~3x wall-clock speedup.
      await Promise.all(layers.filter(l => runners[l]).map(l => runners[l]()));
    } else {
      for (const l of layers) if (runners[l]) await runners[l]();
    }

    generateSummary(absRepo, absOut);
    try {
      const row = db.upsertReport(absOut);
      console.log(chalk.gray(`   Indexed as #${row.id} in ${db.DEFAULT_DB_PATH}`));
    } catch (err) {
      console.error(chalk.yellow(`   ⚠️  Index update failed: ${err.message}`));
    }
    console.log(chalk.green(`\n✅ Done. Report: ${path.join(absOut, 'SUMMARY.md')}`));
  });

program
  .command("standard")
  .description("Show the standard entrypoint-first project architecture used for audits")
  .option("-o, --output <file>", "Write markdown standard to a file")
  .option("--profile <name>", "Architecture standard profile: generic,pure_agent,rag_agent,crm_agent", "generic")
  .action((options) => {
    const md = buildStandardGuide(options.profile);
    if (options.output) {
      const out = path.resolve(options.output);
      fs.mkdirSync(path.dirname(out), { recursive: true });
      fs.writeFileSync(out, md);
      console.log(chalk.green("Standard architecture written to " + out));
    } else {
      console.log(md);
    }
  });

program
  .command("dissect <repo>")
  .description("Dissect entrypoint trunks, deployable units, interfaces, and business-flow skeletons")
  .option("-o, --output <dir>", "Output directory (default: ~/.cache/repo-inv/<repo>-<ts>)")
  .option("--profile <name>", "Architecture standard profile: generic,pure_agent,rag_agent,crm_agent", "generic")
  .action(async (repo, options) => {
    const absRepo = path.resolve(repo);
    if (!fs.existsSync(absRepo) || !fs.statSync(absRepo).isDirectory()) {
      console.error(chalk.red("Error: " + absRepo + " is not a directory"));
      process.exit(1);
    }
    const absOut = path.resolve(options.output || defaultOutputFor(absRepo));
    fs.mkdirSync(absOut, { recursive: true });
    const anatomy = await runAnatomy(absRepo, absOut, { profile: options.profile });
    console.log(chalk.green("\nDone. Anatomy: " + path.join(absOut, "00-anatomy", "ANATOMY.md")));
    console.log(chalk.gray("   Shape: " + anatomy.architecture_shape));
  });

program
  .command('tools')
  .description('List all available tools and their status')
  .option('-l, --layer <layer>', 'Filter by layer: arch, logic, efficiency')
  .action((options) => {
    const results = listTools();
    const filtered = options.layer ? results.filter(t => t.layer === options.layer) : results;

    console.log(chalk.bold('\n📦 Available Tools\n'));

    const byLayer = { arch: [], logic: [], efficiency: [] };
    filtered.forEach(t => { if (byLayer[t.layer]) byLayer[t.layer].push(t); });

    for (const [layer, tools] of Object.entries(byLayer)) {
      if (tools.length === 0) continue;
      const icon = layer === 'arch' ? '🏗️' : layer === 'logic' ? '🧠' : '⚡';
      console.log(chalk.bold(`${icon} ${layer.toUpperCase()}`));
      for (const t of tools) {
        const status = t.found ? chalk.green('✅') : chalk.red('❌');
        const ver = t.found ? chalk.gray(t.version) : chalk.gray('not found');
        const info = getTool(t.key);
        console.log(`  ${status} ${chalk.white(info.name)} ${ver} — ${info.desc}`);
      }
      console.log('');
    }
  });

program
  .command('tool <name>')
  .description('Show usage details for a specific tool')
  .action((name) => {
    const tool = getTool(name);
    if (!tool) {
      console.error(chalk.red(`Unknown tool: ${name}`));
      console.log(`Run ${chalk.cyan('repo-inv tools')} to list available tools.`);
      process.exit(1);
    }
    const status = checkTool(name);
    console.log(chalk.bold(`\n🔧 ${tool.name}\n`));
    console.log(`  Layer:     ${tool.layer}`);
    console.log(`  Status:    ${status.found ? chalk.green('installed') : chalk.red('not found')}`);
    if (status.version) console.log(`  Version:   ${status.version}`);
    console.log(`  Desc:      ${tool.desc}`);
    console.log(`  Command:   ${chalk.cyan(tool.cmd)}`);
    console.log(`  Tips:      ${chalk.gray(tool.tips)}`);
    console.log('');
  });

program
  .command('report [output]')
  .description('Show summary of an investigation (defaults to most recent in ~/.cache/repo-inv/)')
  .action((output) => {
    let dir;
    if (output) {
      dir = path.resolve(output);
    } else if (fs.existsSync(DEFAULT_OUT_ROOT)) {
      const runs = fs.readdirSync(DEFAULT_OUT_ROOT)
        .map(name => ({ name, full: path.join(DEFAULT_OUT_ROOT, name) }))
        .filter(e => { try { return fs.statSync(e.full).isDirectory(); } catch { return false; } })
        .sort((a, b) => fs.statSync(b.full).mtimeMs - fs.statSync(a.full).mtimeMs);
      if (runs.length === 0) {
        console.error(chalk.red(`No reports found under ${DEFAULT_OUT_ROOT}`));
        process.exit(1);
      }
      dir = runs[0].full;
    } else {
      dir = path.resolve('./investigation-report');
    }
    const summary = path.join(dir, 'SUMMARY.md');
    if (!fs.existsSync(summary)) {
      console.error(chalk.red(`No report found at ${summary}`));
      console.log(`Run ${chalk.cyan('repo-inv analyze <repo>')} first.`);
      process.exit(1);
    }
    console.log(chalk.gray(`# from: ${dir}\n`));
    console.log(fs.readFileSync(summary, 'utf8'));
  });

program
  .command('init')
  .description('Initialize .repo-inv.json config in current directory')
  .action(() => {
    const config = {
      version: '1.0.0',
      defaults: {
        layers: 'all',
        output: './investigation-report',
      },
      tools: {
        semgrep: { config: 'auto' },
        lizard: { threshold: 15 },
        'py-spy': { duration: 5 },
      },
    };
    fs.writeFileSync('.repo-inv.json', JSON.stringify(config, null, 2));
    console.log(chalk.green('✅ Created .repo-inv.json'));
  });

// ── learn ──────────────────────────────────────────────────────────────────
// Feed report.json + SUMMARY.md into an LLM for a synthesized "what to learn
// from this codebase" briefing. Reads DEEPSEEK_API_KEY from env or the suite's
// .env file (no extra deps).
const { loadEnvFromFile } = require('../lib/env');

program
  .command('learn [output]')
  .description('Use DeepSeek to synthesize a "what to learn" briefing from the latest report')
  .option('-m, --model <name>', 'DeepSeek model id', 'deepseek-chat')
  .option('--max-snippets <n>', 'Max chars of lizard hotspot context to include', '4000')
  .action(async (output, options) => {
    loadEnvFromFile(path.join(__dirname, '..', '.env'));
    const apiKey = process.env.DEEPSEEK_API_KEY;
    if (!apiKey) {
      console.error(chalk.red('❌ DEEPSEEK_API_KEY not set. Add it to .env (in suite root) or export it.'));
      console.log(chalk.gray('   Example: echo "DEEPSEEK_API_KEY=sk-..." >> ' + path.join(__dirname, '..', '.env')));
      process.exit(1);
    }

    // Pick latest run if no path
    let dir;
    if (output) {
      dir = path.resolve(output);
    } else if (fs.existsSync(DEFAULT_OUT_ROOT)) {
      const runs = fs.readdirSync(DEFAULT_OUT_ROOT)
        .map(name => ({ name, full: path.join(DEFAULT_OUT_ROOT, name) }))
        .filter(e => { try { return fs.statSync(e.full).isDirectory(); } catch { return false; } })
        .sort((a, b) => fs.statSync(b.full).mtimeMs - fs.statSync(a.full).mtimeMs);
      if (runs.length === 0) {
        console.error(chalk.red(`No reports found under ${DEFAULT_OUT_ROOT}`));
        process.exit(1);
      }
      dir = runs[0].full;
    } else {
      console.error(chalk.red('No report dir specified and no cache found.'));
      process.exit(1);
    }

    const reportPath = path.join(dir, 'report.json');
    const summaryPath = path.join(dir, 'SUMMARY.md');
    if (!fs.existsSync(reportPath) || !fs.existsSync(summaryPath)) {
      console.error(chalk.red(`Missing report.json or SUMMARY.md in ${dir}`));
      console.log(`Run ${chalk.cyan('repo-inv analyze <repo>')} first.`);
      process.exit(1);
    }

    console.log(chalk.bold('🧠 Synthesizing learnings via DeepSeek...'));
    console.log(`   Source: ${chalk.cyan(dir)}`);
    console.log(`   Model:  ${chalk.yellow(options.model)}`);

    const report = JSON.parse(fs.readFileSync(reportPath, 'utf8'));
    const summary = fs.readFileSync(summaryPath, 'utf8');

    const prompt = `你是开源仓库架构分析专家。下面是对仓库 "${report.repo.name}" 的静态分析结果，请输出**学习指南**，包含：

1. **架构速读**（3-5 句）：项目规模、主语言、模块边界、调用图入口
2. **业务逻辑核心**（5-10 个最值得读的函数/文件，按 lizard hotspots + 调用图入口推导）
3. **质量画像**：semgrep/bandit/pyright/vulture 综合，按严重度排序
4. **可借鉴的设计点**（这个项目里哪些模式/手法值得在我自己的项目中复用）
5. **风险与盲区**（这个项目里哪些代码不要学）

要点：
- 直接给结论，不要复述输入数据
- 引用具体文件/函数名，不要泛泛而谈
- 中文输出，Markdown 格式
- 总长度控制在 800-1200 字

=== report.json ===
${JSON.stringify(report, null, 2).slice(0, 12000)}

=== SUMMARY.md ===
${summary.slice(0, parseInt(options.maxSnippets, 10) || 4000)}
`;

    try {
      const resp = await fetch('https://api.deepseek.com/v1/chat/completions', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${apiKey}`,
        },
        body: JSON.stringify({
          model: options.model,
          messages: [
            { role: 'system', content: '你是资深开源代码考古学家，擅长从静态分析数据反向推导项目的设计意图与可学习点。' },
            { role: 'user', content: prompt },
          ],
          temperature: 0.3,
        }),
      });
      if (!resp.ok) {
        console.error(chalk.red(`❌ DeepSeek API error: ${resp.status} ${resp.statusText}`));
        console.error(await resp.text());
        process.exit(1);
      }
      const data = await resp.json();
      const content = data.choices?.[0]?.message?.content || '';
      const learningsPath = path.join(dir, 'LEARNINGS.md');
      fs.writeFileSync(learningsPath, content);
      console.log(chalk.green(`\n✅ Learnings written to ${learningsPath}\n`));
      try {
        db.upsertReport(dir);
        console.log(chalk.gray(`   Index refreshed with new learnings.\n`));
      } catch (err) {
        console.error(chalk.yellow(`   ⚠️  Index refresh failed: ${err.message}\n`));
      }
      console.log(content);
    } catch (err) {
      console.error(chalk.red(`❌ Request failed: ${err.message}`));
      process.exit(1);
    }
  });

// ── list ───────────────────────────────────────────────────────────────────
// Show every indexed repo, sorted by recency / size / quality.
program
  .command('list')
  .description('List all indexed repos in the knowledge base')
  .option('--by <field>', 'Sort by: recent, size, quality, complexity', 'recent')
  .action((options) => {
    const orderMap = {
      recent: 'scanned_at DESC',
      size: 'total_code DESC',
      quality: '(IFNULL(semgrep_error,0)+IFNULL(bandit_high,0)+IFNULL(pyright_errors,0)) ASC',
      complexity: 'lizard_max_ccn DESC',
    };
    const orderBy = orderMap[options.by] || orderMap.recent;
    const rows = db.listRepos({ orderBy });
    if (rows.length === 0) {
      console.log(chalk.yellow('No repos indexed yet. Run `repo-inv analyze <repo>` first.'));
      return;
    }
    console.log(chalk.bold(`\n📚 Indexed repos (sorted by ${options.by})\n`));
    const fmt = (n) => n == null ? '—' : String(n);
    const pad = (s, w) => String(s).padEnd(w);
    console.log(chalk.gray(pad('NAME', 24) + pad('LANG', 10) + pad('LOC', 10) + pad('MAX CCN', 9) + pad('SEC-HI', 8) + pad('PYR-ERR', 9) + 'SCANNED'));
    console.log(chalk.gray('─'.repeat(100)));
    for (const r of rows) {
      const secHigh = (r.semgrep_error || 0) + (r.bandit_high || 0);
      console.log(
        pad(r.name.slice(0, 23), 24) +
        pad(r.primary_lang || '—', 10) +
        pad(fmt(r.total_code), 10) +
        pad(fmt(r.lizard_max_ccn), 9) +
        pad(fmt(secHigh), 8) +
        pad(fmt(r.pyright_errors), 9) +
        chalk.gray(r.scanned_at.slice(0, 19))
      );
    }
    console.log('');
  });

// ── search ─────────────────────────────────────────────────────────────────
// FTS5 query against LEARNINGS.md + SUMMARY.md content of every indexed repo.
program
  .command('search <query>')
  .description('Full-text search across all indexed learnings & summaries (FTS5 syntax)')
  .option('--lang <lang>', 'Filter by primary language')
  .option('--max-ccn <n>', 'Only repos whose max CCN ≤ n (find clean codebases)', parseInt)
  .option('--limit <n>', 'Max results', (v) => parseInt(v, 10), 20)
  .action((query, options) => {
    let rows;
    try {
      rows = db.searchRepos(query, { limit: options.limit });
    } catch (err) {
      console.error(chalk.red(`FTS query failed: ${err.message}`));
      console.log(chalk.gray('Hint: FTS5 syntax — use OR, "phrase", -term, prefix*'));
      process.exit(1);
    }
    if (options.lang) rows = rows.filter(r => (r.primary_lang || '').toLowerCase() === options.lang.toLowerCase());
    if (options.maxCcn != null) rows = rows.filter(r => r.lizard_max_ccn != null && r.lizard_max_ccn <= options.maxCcn);

    if (rows.length === 0) {
      console.log(chalk.yellow(`No matches for "${query}".`));
      return;
    }
    console.log(chalk.bold(`\n🔎 ${rows.length} match(es) for "${query}"\n`));
    for (const r of rows) {
      console.log(chalk.cyan(`▶ ${r.name}`) + chalk.gray(`  [${r.primary_lang || '—'}, ${r.total_code || '?'} LOC, max CCN ${r.lizard_max_ccn ?? '?'}]`));
      if (r.hit_learnings && r.hit_learnings !== '') console.log('  ' + chalk.gray('learnings:') + ' ' + r.hit_learnings);
      if (r.hit_summary && r.hit_summary !== '') console.log('  ' + chalk.gray('summary:  ') + ' ' + r.hit_summary);
      console.log(chalk.gray(`  → ${r.report_dir}\n`));
    }
  });

// ── compare ────────────────────────────────────────────────────────────────
// Side-by-side comparison of two indexed repos: lang mix, complexity, safety.
program
  .command('compare <repoA> <repoB>')
  .description('Side-by-side comparison of two indexed repos')
  .action((repoA, repoB) => {
    const a = db.getRepoByName(repoA);
    const b = db.getRepoByName(repoB);
    if (!a) { console.error(chalk.red(`Repo "${repoA}" not found in index.`)); process.exit(1); }
    if (!b) { console.error(chalk.red(`Repo "${repoB}" not found in index.`)); process.exit(1); }

    const pad = (s, w) => String(s == null ? '—' : s).padEnd(w);
    const row = (label, va, vb) => {
      const flag = (typeof va === 'number' && typeof vb === 'number' && va !== vb)
        ? (va < vb ? chalk.green(' ◀ A better') : chalk.green(' B better ▶'))
        : '';
      console.log(pad(label, 22) + pad(va, 22) + pad(vb, 22) + flag);
    };

    console.log(chalk.bold(`\n⚖️  ${a.name}  vs  ${b.name}\n`));
    console.log(chalk.gray(pad('METRIC', 22) + pad(a.name.slice(0, 21), 22) + pad(b.name.slice(0, 21), 22)));
    console.log(chalk.gray('─'.repeat(70)));
    row('primary_lang',     a.primary_lang, b.primary_lang);
    row('total_files',      a.total_files, b.total_files);
    row('total_code',       a.total_code, b.total_code);
    row('total_complexity', a.total_complexity, b.total_complexity);
    row('lizard_max_ccn',   a.lizard_max_ccn, b.lizard_max_ccn);
    row('hotspots (>=15)',  a.lizard_hotspot_count, b.lizard_hotspot_count);
    row('semgrep ERROR',    a.semgrep_error, b.semgrep_error);
    row('bandit HIGH',      a.bandit_high, b.bandit_high);
    row('pyright errors',   a.pyright_errors, b.pyright_errors);
    row('mypy errors',      a.mypy_errors, b.mypy_errors);
    row('vulture candidates', a.vulture_candidates, b.vulture_candidates);
    row('jscpd %',          a.jscpd_pct, b.jscpd_pct);

    console.log(chalk.bold('\nLanguage mix:'));
    const langs = new Set([...(a.languages || []).map(l => l.name), ...(b.languages || []).map(l => l.name)]);
    const aLang = Object.fromEntries((a.languages || []).map(l => [l.name, l.code]));
    const bLang = Object.fromEntries((b.languages || []).map(l => [l.name, l.code]));
    const ranked = [...langs].sort((x, y) => (Math.max(bLang[y] || 0, aLang[y] || 0)) - (Math.max(bLang[x] || 0, aLang[x] || 0))).slice(0, 8);
    console.log(chalk.gray(pad('LANG', 22) + pad('A loc', 22) + pad('B loc', 22)));
    for (const l of ranked) row(l, aLang[l] || 0, bLang[l] || 0);

    console.log(chalk.bold(`\nTop hotspots — ${a.name}:`));
    for (const h of (a.hotspots || []).slice(0, 5)) console.log(`  CCN ${pad(h.ccn, 4)} ${h.location}`);
    console.log(chalk.bold(`\nTop hotspots — ${b.name}:`));
    for (const h of (b.hotspots || []).slice(0, 5)) console.log(`  CCN ${pad(h.ccn, 4)} ${h.location}`);
    console.log('');
  });

// ── borrow ─────────────────────────────────────────────────────────────────
// Heuristic guide for choosing indexed excellent repos, patterns, and hotspots
// worth learning from or extracting as small wheels.
program
  .command("borrow <topic...>")
  .description("Find learning targets and borrowable wheels from indexed excellent repos")
  .option("-o, --output <file>", "Write markdown guide to a file")
  .option("--limit <n>", "Max repositories to include", (v) => parseInt(v, 10), 5)
  .action((topicParts, options) => {
    const topic = topicParts.join(" ").trim();
    const result = buildBorrowGuide(topic, { limit: options.limit });
    if (options.output) {
      const out = path.resolve(options.output);
      fs.mkdirSync(path.dirname(out), { recursive: true });
      fs.writeFileSync(out, result.markdown);
      console.log(chalk.green("Borrow guide written to " + out));
    } else {
      console.log(result.markdown);
    }
  });

// ── review ─────────────────────────────────────────────────────────────────
// Review a user project from an existing repo-inv report/index row. This is
// the second half of the workflow: test personal code against learned patterns.
program
  .command("review <repoOrReport>")
  .description("Review your own indexed project for architecture, skeleton, business logic, and copy risk")
  .option("--against <repo>", "Name of an indexed excellent repo to compare against")
  .option("-o, --output <file>", "Write markdown review to a file")
  .option("--profile <name>", "Architecture standard profile: generic,pure_agent,rag_agent,crm_agent", "generic")
  .action((repoOrReport, options) => {
    try {
      const result = buildProjectReview(repoOrReport, { against: options.against, profile: options.profile });
      if (options.output) {
        const out = path.resolve(options.output);
        fs.mkdirSync(path.dirname(out), { recursive: true });
        fs.writeFileSync(out, result.markdown);
        console.log(chalk.green("Project review written to " + out));
      } else {
        console.log(result.markdown);
      }
    } catch (err) {
      console.error(chalk.red("ERROR " + err.message));
      process.exit(1);
    }
  });

// ── audit ──────────────────────────────────────────────────────────────────
// Alias with the new product language: audit user projects against a target trunk.
program
  .command("audit <repoOrReport>")
  .description("Audit your own indexed project against a target architecture trunk")
  .option("--against <repo>", "Name of an indexed excellent repo to compare against")
  .option("-o, --output <file>", "Write markdown audit to a file")
  .option("--profile <name>", "Architecture standard profile: generic,pure_agent,rag_agent,crm_agent", "generic")
  .action((repoOrReport, options) => {
    try {
      const result = buildProjectReview(repoOrReport, { against: options.against, profile: options.profile });
      if (options.output) {
        const out = path.resolve(options.output);
        fs.mkdirSync(path.dirname(out), { recursive: true });
        fs.writeFileSync(out, result.markdown);
        console.log(chalk.green("Project audit written to " + out));
      } else {
        console.log(result.markdown);
      }
    } catch (err) {
      console.error(chalk.red("ERROR " + err.message));
      process.exit(1);
    }
  });

// ── patterns ───────────────────────────────────────────────────────────────
// Run curated semgrep rules to detect architectural patterns; persist to DB.
program
  .command('patterns <repo>')
  .description('Scan repo for architectural patterns (retry, DI, plugin, cache, ...) and index them')
  .option('--rules <path>', 'Override semgrep rules file', path.join(__dirname, '..', 'rules', 'patterns.yml'))
  .option('--json', 'Emit raw JSON instead of table')
  .action(async (repo, options) => {
    const { spawnSync } = require('child_process');
    const absRepo = path.resolve(repo);
    if (!fs.existsSync(absRepo)) { console.error(chalk.red(`No such dir: ${absRepo}`)); process.exit(1); }
    if (!fs.existsSync(options.rules)) { console.error(chalk.red(`Rules not found: ${options.rules}`)); process.exit(1); }

    console.log(chalk.bold('🧬 Scanning for architectural patterns...'));
    console.log(`   Target: ${chalk.cyan(absRepo)}`);
    console.log(`   Rules:  ${chalk.gray(options.rules)}`);

    const res = spawnSync('semgrep', [
      '--config', options.rules, '--json', '-q', '--metrics', 'off',
      '--exclude', 'node_modules', '--exclude', '.git', '--exclude', 'dist', '--exclude', 'build',
      absRepo,
    ], { encoding: 'utf8', maxBuffer: 256 * 1024 * 1024 });
    if (res.status !== 0 && !res.stdout) {
      console.error(chalk.red(`semgrep failed: ${res.stderr}`));
      process.exit(1);
    }
    const j = JSON.parse(res.stdout);
    const grouped = {};
    for (const r of j.results || []) {
      const id = r.check_id.split('.').pop();
      const cat = r.extra?.metadata?.category || 'unknown';
      if (!grouped[id]) grouped[id] = { pattern: id, category: cat, hits: 0, sample_path: r.path, sample_line: r.start?.line };
      grouped[id].hits += 1;
    }
    const list = Object.values(grouped).sort((a, b) => b.hits - a.hits);

    if (options.json) {
      console.log(JSON.stringify(list, null, 2));
    } else {
      console.log(chalk.bold(`\n📐 ${list.length} pattern(s) detected\n`));
      const pad = (s, w) => String(s).padEnd(w);
      console.log(chalk.gray(pad('PATTERN', 36) + pad('CATEGORY', 14) + pad('HITS', 6) + 'SAMPLE'));
      console.log(chalk.gray('─'.repeat(100)));
      for (const p of list) {
        const sample = p.sample_path ? `${path.relative(absRepo, p.sample_path)}:${p.sample_line}` : '';
        console.log(pad(p.pattern, 36) + pad(p.category, 14) + pad(p.hits, 6) + chalk.gray(sample));
      }
    }

    // Persist into index (if this repo is indexed)
    const name = path.basename(absRepo);
    const existing = db.getRepoByName(name);
    if (existing) {
      db.savePatterns(existing.id, list);
      console.log(chalk.green(`\n✅ Indexed ${list.length} patterns for #${existing.id} ${name}`));
    } else {
      console.log(chalk.yellow(`\n⚠️  Repo "${name}" not in index — run \`repo-inv analyze ${repo}\` first to persist patterns.`));
    }
  });

// ── extract ────────────────────────────────────────────────────────────────
// Copy a file + its 1-hop intra-repo Python imports into a dest dir, so the
// user can transplant a piece of logic without dragging the whole repo.
program
  .command('extract <repo> <target>')
  .description('Extract a file (or file:line) + its 1-hop intra-repo imports for transplant')
  .option('-o, --out <dir>', 'Destination directory', './extracted')
  .option('--max-hops <n>', 'Import resolution depth (default 1)', (v) => parseInt(v, 10), 1)
  .action((repo, target, options) => {
    const absRepo = path.resolve(repo);
    if (!fs.existsSync(absRepo)) { console.error(chalk.red(`No such repo: ${absRepo}`)); process.exit(1); }

    // target can be "path/to/file.py" or "path/to/file.py:123"
    const [relTarget] = target.split(':');
    const startFile = path.isAbsolute(relTarget) ? relTarget : path.resolve(absRepo, relTarget);
    if (!fs.existsSync(startFile)) { console.error(chalk.red(`File not found: ${startFile}`)); process.exit(1); }

    const outDir = path.resolve(options.out);
    fs.mkdirSync(outDir, { recursive: true });

    // BFS over Python imports, resolving "from X.Y import Z" / "import X.Y"
    // to files within absRepo. Anything that doesn't resolve inside the repo
    // is treated as an external dependency and recorded.
    const visited = new Set();
    const externalDeps = new Set();
    const queue = [{ file: startFile, depth: 0 }];

    function resolveImport(modulePath, fromFile) {
      // Try to resolve a dotted module path to a file under absRepo.
      const parts = modulePath.split('.');
      // Walk up from fromFile to find any ancestor under absRepo that contains parts[0]
      let dir = path.dirname(fromFile);
      while (dir.startsWith(absRepo)) {
        const cand1 = path.join(dir, ...parts) + '.py';
        const cand2 = path.join(dir, ...parts, '__init__.py');
        if (fs.existsSync(cand1)) return cand1;
        if (fs.existsSync(cand2)) return cand2;
        if (dir === absRepo) break;
        dir = path.dirname(dir);
      }
      return null;
    }

    while (queue.length) {
      const { file, depth } = queue.shift();
      if (visited.has(file)) continue;
      visited.add(file);
      const src = fs.readFileSync(file, 'utf8');
      if (depth >= options.maxHops) continue;
      const importLines = src.split('\n').filter(l => /^\s*(from\s+\S+\s+import|import\s+)/.test(l));
      for (const line of importLines) {
        const m1 = line.match(/^\s*from\s+(\.*\S+)\s+import/);
        const m2 = line.match(/^\s*import\s+(\S+)/);
        const mod = (m1 && m1[1]) || (m2 && m2[1]);
        if (!mod) continue;
        if (mod.startsWith('.')) {
          // relative import: resolve against current dir
          const dots = mod.match(/^\.+/)[0].length;
          let dir = path.dirname(file);
          for (let i = 1; i < dots; i++) dir = path.dirname(dir);
          const rest = mod.slice(dots).split('.').filter(Boolean);
          const cand1 = path.join(dir, ...rest) + '.py';
          const cand2 = path.join(dir, ...rest, '__init__.py');
          if (fs.existsSync(cand1)) queue.push({ file: cand1, depth: depth + 1 });
          else if (fs.existsSync(cand2)) queue.push({ file: cand2, depth: depth + 1 });
          else externalDeps.add(mod);
        } else {
          const resolved = resolveImport(mod, file);
          if (resolved) queue.push({ file: resolved, depth: depth + 1 });
          else externalDeps.add(mod.split('.')[0]);
        }
      }
    }

    // Copy preserving repo-relative layout
    for (const f of visited) {
      const rel = path.relative(absRepo, f);
      const dest = path.join(outDir, rel);
      fs.mkdirSync(path.dirname(dest), { recursive: true });
      fs.copyFileSync(f, dest);
    }

    // Filter stdlib from external deps so the list is useful for pip install
    const STDLIB = new Set(['abc','argparse','asyncio','base64','collections','contextlib','copy','dataclasses','datetime','decimal','enum','functools','hashlib','heapq','inspect','io','ipaddress','itertools','json','logging','math','os','pathlib','pickle','queue','random','re','shutil','socket','string','struct','subprocess','sys','tempfile','threading','time','traceback','types','typing','unittest','urllib','uuid','warnings','weakref','xml','zipfile']);
    const pipDeps = [...externalDeps].filter(d => !STDLIB.has(d)).sort();

    const manifest = {
      schema: 'repo-inv/extract@1',
      source_repo: absRepo,
      entry: path.relative(absRepo, startFile),
      max_hops: options.maxHops,
      files: [...visited].map(f => path.relative(absRepo, f)),
      external_deps: pipDeps,
      stdlib_deps: [...externalDeps].filter(d => STDLIB.has(d)).sort(),
      extracted_at: new Date().toISOString(),
    };
    fs.writeFileSync(path.join(outDir, 'EXTRACT.json'), JSON.stringify(manifest, null, 2));

    console.log(chalk.bold(`\n📦 Extracted ${visited.size} file(s) to ${outDir}`));
    console.log(chalk.gray(`   Entry: ${manifest.entry}`));
    console.log(chalk.gray(`   pip deps: ${pipDeps.join(', ') || '(none)'}`));
    console.log(chalk.gray(`   stdlib:   ${manifest.stdlib_deps.join(', ') || '(none)'}`));
    console.log(chalk.gray(`   Manifest: ${path.join(outDir, 'EXTRACT.json')}\n`));
  });

// ── recommend ──────────────────────────────────────────────────────────────
// Ask DeepSeek: given a task, which indexed repos / patterns / hotspots should
// I study to copy-paste-with-thinking?
program
  .command('recommend <task...>')
  .description('Ask DeepSeek to recommend which indexed repos/patterns/funcs to study for a task')
  .option('-m, --model <name>', 'DeepSeek model', 'deepseek-chat')
  .action(async (taskParts, options) => {
    loadEnvFromFile(path.join(__dirname, '..', '.env'));
    const apiKey = process.env.DEEPSEEK_API_KEY;
    if (!apiKey) { console.error(chalk.red('❌ DEEPSEEK_API_KEY not set in .env')); process.exit(1); }

    const task = taskParts.join(' ');
    const catalog = db.catalogForPrompt();
    if (catalog.length === 0) { console.error(chalk.red('No repos indexed yet.')); process.exit(1); }

    console.log(chalk.bold('🎯 Asking DeepSeek for recommendations...'));
    console.log(`   Task:    ${chalk.cyan(task)}`);
    console.log(`   Catalog: ${chalk.yellow(catalog.length)} indexed repo(s)`);

    const compactCatalog = catalog.map(r => ({
      name: r.name,
      lang: r.primary_lang,
      loc: r.total_code,
      max_ccn: r.lizard_max_ccn,
      quality: { semgrep_err: r.semgrep_error, bandit_high: r.bandit_high, pyright_err: r.pyright_errors },
      patterns: r.patterns.map(p => `${p.pattern}×${p.hits}`),
      hotspots: r.hotspots.map(h => `${h.location} (CCN ${h.ccn})`),
      learnings_excerpt: r.learnings_excerpt.slice(0, 800),
    }));

    const prompt = `用户任务："${task}"

下面是已索引开源仓库的目录（每条含语言/规模/质量/检测到的架构模式/复杂度热点/AI 提炼的学习摘要）。请像"开源代码考古学家"一样输出**抄作业指南**：

1. **首选参考仓库**（按相关度排序 1-3 个）：说明为什么这个仓库的方案最匹配该任务
2. **核心可抄代码**：精确到 \`仓库:文件:函数\`，告诉用户重点读哪些 hotspot
3. **可抄架构模式**：从 patterns 列表里挑出可以"排列组合"借用的（写明从哪个仓库的哪个 pattern 借哪个思路）
4. **风险/陷阱**：哪些仓库虽然相关但质量差不建议抄、哪些 hotspot 复杂度过高需要重构后再用
5. **行动清单**：3-5 条具体命令/步骤，**只允许使用下列真实命令**：
   - \`repo-inv extract <repo-path> <file-relative-path> --out <dir> [--max-hops N]\`
   - \`repo-inv compare <repoA-name> <repoB-name>\`
   - \`repo-inv search "<fts5-query>" [--lang X] [--max-ccn N]\`
   - \`repo-inv patterns <repo-path>\`
   不要发明不存在的子命令或参数。

规则：
- 必须基于目录里的真实数据，禁止幻觉仓库或文件名
- 引用具体数字（hits、CCN、LOC）做依据
- 中文 Markdown，700-1000 字

=== 目录 ===
${JSON.stringify(compactCatalog, null, 2)}
`;

    try {
      const resp = await fetch('https://api.deepseek.com/v1/chat/completions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${apiKey}` },
        body: JSON.stringify({
          model: options.model,
          messages: [
            { role: 'system', content: '你是资深开源代码考古学家，擅长跨仓库为某个具体任务挑选最佳"抄作业"路径。' },
            { role: 'user', content: prompt },
          ],
          temperature: 0.3,
        }),
      });
      if (!resp.ok) {
        console.error(chalk.red(`❌ DeepSeek error: ${resp.status}`));
        console.error(await resp.text());
        process.exit(1);
      }
      const data = await resp.json();
      const content = data.choices?.[0]?.message?.content || '';
      console.log('\n' + content + '\n');
    } catch (err) {
      console.error(chalk.red(`❌ ${err.message}`));
      process.exit(1);
    }
  });

// ── manifest ───────────────────────────────────────────────────────────────
